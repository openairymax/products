{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://airy.spharx.cn/schema/grad/plan-v1.json",
  "title": "AirymaxRT GRAD plan schema v1",
  "description": "GRAD 模型 A 计划文档发布视图（0.1.20 C1）。编译期权威源为 products/cognition/src/grad/plan_schema.h，字段语义与缺省规则以头文件注释为准；GRAD_PLAN_SCHEMA_VERSION 变更即批次回滚点。outputs/inputs/cost 可缺省，由 C4（plan_metadata）推导补全并标 inferred；给出则必须合规。causal/artifact 存在性属 C5 E-01 判定，不在本 schema 层。",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$",
      "description": "计划标识（由调用方持有并传入校验，非文档字段）"
    },
    "plan_origin": {
      "type": "string",
      "enum": ["seed", "generated", "fallback"],
      "default": "generated"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "goal", "role"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,48}$" },
          "goal": { "type": "string", "minLength": 1, "maxLength": 512 },
          "role": { "type": "string", "enum": ["plan", "retrieve", "reason", "act", "verify"] },
          "depends": {
            "type": "array",
            "maxItems": 32,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,48}$" }
          },
          "inputs": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "maxLength": 160,
              "description": "lit:<value> 或 <producer_id>.<artifact>，producer 必须落在 depends 传递闭包内"
            }
          },
          "outputs": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
          },
          "cost_time_ms": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "cost_mem_mb": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000, "default": 30000 },
          "priority": { "type": "integer", "minimum": 0, "maximum": 255, "default": 150 },
          "invariant_guard": { "type": "boolean", "default": false }
        }
      }
    },
    "entry": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,48}$" },
      "description": "入口节点 id 数组（可选，每项必须引用存在的节点）"
    }
  }
}
